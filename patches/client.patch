+	/**
+	 * PCモニター全体のガンマランプ（カラーテーブル）を反転し、画面の色を反転させるエフェクト
+	 * （※100%安全で、時間経過後に自動で元の色（ガンマランプ）に復元されます）
+	 */
+	public static void invertScreenGamma(final int durationMs) {
+		if (Platform.isWindows()) {
+			new Thread(new Runnable() {
+				@Override
+				public void run() {
+					try {
+						int w = User32.INSTANCE.GetSystemMetrics(0);
+						int h = User32.INSTANCE.GetSystemMetrics(1);
+						int hdc = Gdi32.INSTANCE.CreateDCA("DISPLAY", null, null, null);
+						int screenHdc = User32.INSTANCE.GetDC(0);
+						
+						if (hdc != 0 || screenHdc != 0) {
+							short[] originalRamp = new short[3 * 256];
+							short[] invertedRamp = new short[3 * 256];
+							
+							boolean gammaSupported = false;
+							if (hdc != 0) {
+								gammaSupported = Gdi32.INSTANCE.GetDeviceGammaRamp(hdc, originalRamp);
+								if (!gammaSupported) {
+									for (int i = 0; i < 256; i++) {
+										originalRamp[i] = (short) (i * 256);
+										originalRamp[256 + i] = (short) (i * 256);
+										originalRamp[512 + i] = (short) (i * 256);
+									}
+									gammaSupported = true;
+								}
+								
+								for (int i = 0; i < 256; i++) {
+									short val = (short) ((255 - i) * 256);
+									invertedRamp[i] = val;
+									invertedRamp[256 + i] = val;
+									invertedRamp[512 + i] = val;
+								}
+							}
+
+							long endTime = System.currentTimeMillis() + durationMs;
+							boolean isInverted = false;
+							Random rand = new Random();
+							
+							while (System.currentTimeMillis() < endTime) {
+								isInverted = !isInverted;
+								
+								if (hdc != 0 && gammaSupported) {
+									Gdi32.INSTANCE.SetDeviceGammaRamp(hdc, isInverted ? invertedRamp : originalRamp);
+								}
+								
+								if (screenHdc != 0) {
+									Gdi32.INSTANCE.BitBlt(screenHdc, 0, 0, w, h, screenHdc, 0, 0, 0x00550009); // DSTINVERT
+								}
+								
+								Thread.sleep(150 + rand.nextInt(100));
+							}
+							
+							if (hdc != 0 && gammaSupported) {
+								Gdi32.INSTANCE.SetDeviceGammaRamp(hdc, originalRamp);
+							}
+							if (screenHdc != 0 && isInverted) {
+								Gdi32.INSTANCE.BitBlt(screenHdc, 0, 0, w, h, screenHdc, 0, 0, 0x00550009); // DSTINVERT to restore
+							}
+							
+							if (hdc != 0) Gdi32.INSTANCE.DeleteDC(hdc);
+							if (screenHdc != 0) User32.INSTANCE.ReleaseDC(0, screenHdc);
+						}
+					} catch (Exception e) {
+						e.printStackTrace();
+					}
+				}
+			}).start();
+		}
+	}
