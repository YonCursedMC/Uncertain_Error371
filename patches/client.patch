+package net.minecraft.src;
+
+import java.io.BufferedInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import javax.sound.sampled.*;
+
+public class WavPlaySound {
+
+	public static void playsound(String resourcePath) {
+		playsound(resourcePath, Integer.MAX_VALUE, false);
+	}
+
+	public static void playsound(String resourcePath, final int durationMs) {
+		playsound(resourcePath, durationMs, false);
+	}
+
+	public static void playsound(String resourcePath, final int durationMs, final boolean loop) {
+		new Thread(()->{
+			try(InputStream rawStream = WavPlaySound.class.getResourceAsStream(resourcePath)) {
+				if(rawStream == null) {
+					System.err.println("Non Resource: " + resourcePath); return;
+				}
+
+				try(BufferedInputStream bufferedStream = new BufferedInputStream(rawStream); AudioInputStream audioInputStream = AudioSystem.getAudioInputStream(bufferedStream)) {
+
+					Clip clip = AudioSystem.getClip();
+					clip.open(audioInputStream);
+					if (loop) {
+						clip.loop(Clip.LOOP_CONTINUOUSLY);
+					} else {
+						clip.start();
+					}
+
+					clip.addLineListener(event->{
+						if(event.getType() == LineEvent.Type.STOP) {
+							clip.close();
+						}
+					});
+
+					long startTime = System.currentTimeMillis();
+					long endTime = startTime + durationMs;
+					while(clip.isOpen()) {
+						if (!clip.isRunning()) {
+							if (System.currentTimeMillis() > startTime + 300) {
+								break;
+							}
+						}
+						if (System.currentTimeMillis() >= endTime) {
+							clip.stop();
+							clip.close();
+							break;
+						}
+						Thread.sleep(50);
+					}
+				}
+
+			} catch (UnsupportedAudioFileException | IOException | LineUnavailableException e) {
+				e.printStackTrace();
+			} catch (InterruptedException e) {
+				Thread.currentThread().interrupt();
+			}
+		}).start();
+	}
+}
