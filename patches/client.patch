+public class NoiseTextureHelper {
+	private static int textureId = 0;
+	private static ByteBuffer buffer = null;
+	private static final Random rand = new Random();
+	private static final int SIZE = 256;
+
+	public static int getNoiseTextureId() {
+		if (textureId == 0) {
+			textureId = GL11.glGenTextures();
+			GL11.glBindTexture(GL11.GL_TEXTURE_2D, textureId);
+			GL11.glTexParameteri(GL11.GL_TEXTURE_2D, GL11.GL_TEXTURE_MIN_FILTER, GL11.GL_NEAREST);
+			GL11.glTexParameteri(GL11.GL_TEXTURE_2D, GL11.GL_TEXTURE_MAG_FILTER, GL11.GL_NEAREST);
+			
+			// Pre-allocate texture on GPU
+			GL11.glTexImage2D(GL11.GL_TEXTURE_2D, 0, GL11.GL_RGBA, SIZE, SIZE, 0, GL11.GL_RGBA, GL11.GL_UNSIGNED_BYTE, (ByteBuffer) null);
+			
+			buffer = ByteBuffer.allocateDirect(SIZE * SIZE * 4);
+			buffer.order(ByteOrder.nativeOrder());
+		}
+
+		// Fill buffer with high-contrast TV static noise (strictly white/gray pixels)
+		buffer.clear();
+		for (int i = 0; i < SIZE * SIZE; i++) {
+			byte val = (byte) (rand.nextBoolean() ? 255 : 50); // White (255) or Dark Gray (50)
+			buffer.put(val); // Red
+			buffer.put(val); // Green
+			buffer.put(val); // Blue
+			buffer.put((byte) 255); // Alpha
+		}
+		buffer.flip();
+
+		GL11.glBindTexture(GL11.GL_TEXTURE_2D, textureId);
+		GL11.glTexSubImage2D(GL11.GL_TEXTURE_2D, 0, 0, 0, SIZE, SIZE, GL11.GL_RGBA, GL11.GL_UNSIGNED_BYTE, buffer);
+
+		return textureId;
+	}
